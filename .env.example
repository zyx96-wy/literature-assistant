# ===========================================
# 复制本文件为 .env 并填入你自己的 Key
#   cp .env.example .env      (Linux / macOS)
#   copy .env.example .env    (Windows)
# ===========================================

# ---- 必需 ----
# 阿里云百炼 DashScope API Key（用于 LLM 问答 / 深解析 / embedding）
# 获取：https://bailian.console.aliyun.com/  →  API-KEY 管理
DASHSCOPE_API_KEY=sk-在这里粘贴你的Key

# ---- 可选（仅跑 eval/eval_dify.py 做对比评测时需要）----
# DIFY_API_KEY=app-在这里粘贴你的Key
# DIFY_API_BASE=https://api.dify.ai/v1
